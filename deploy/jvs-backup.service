[Unit]
Description=jvs 資料庫和圖片備份

[Service]
Type=oneshot
User=jvs
WorkingDirectory=/opt/jvs
ExecStart=/bin/sh -c 'sqlite3 data/bot.db ".backup data/backups/bot-$(date +%%F).db" && find data/backups -name "bot-*.db" -mtime +14 -delete; if [ -d data/images ]; then tar czf data/backups/images.tgz -C data images; fi'
