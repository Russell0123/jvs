# Discord Developer Portal → 你的 App → Bot → Reset Token
DISCORD_TOKEN=
# 提醒頻道 ID（開發者模式下在頻道上按右鍵 → 複製頻道 ID）。提醒一律發到第一個；
# 在其他頻道 @bot 也會回（設定頁可以關掉，關掉就只在這些頻道回應）
CHANNEL_IDS=
# 你的 Discord 使用者 ID（開發者模式下在自己頭像上按右鍵 → 複製使用者 ID）
# 你沒 @ bot、只是在頻道裡說「我想畫…」「之後想買…」，bot 也會幫你記下來；其他人預設不會觸發
OWNER_ID=
# 中央氣象署開放資料平台的授權碼：https://opendata.cwa.gov.tw/
CWA_API_KEY=

# 第二個 bot「蔣寶」：填了 token 就會跟賈維斯一起跑（同一個設定網頁，最左邊切換），
# 資料庫是 data/jbao.db、圖片在 data/images-jbao，跟賈維斯完全分開。預設什麼都不回，到設定網頁打開「回應訊息」才會動。
JBAO_DISCORD_TOKEN=
# 蔣寶的頻道 ID；不填就跟 CHANNEL_IDS 一樣
JBAO_CHANNEL_IDS=

# 第三個 bot「雪豹」：被 @ 就從圖庫照洗好的順序發一張圖＋貓咪顏文字（data/snow.db、data/images-snow）
SNOW_DISCORD_TOKEN=
SNOW_CHANNEL_IDS=

# 以下通常不用改
DB_PATH=data/bot.db
TZ_NAME=Asia/Taipei
WEB_HOST=127.0.0.1
WEB_PORT=8080
# 用 Cloudflare Access 保護設定頁時填你的 email（只有 Access 驗證過、且是這個 email 才放行）
ADMIN_EMAIL=
# 設定網頁的帳密（公開網址一定要填；deploy/public-web.sh 會幫你填）
WEB_USER=admin
WEB_PASSWORD=
# 設定網頁的公開網址（/設定 的按鈕會連過去）
WEB_PUBLIC_URL=
