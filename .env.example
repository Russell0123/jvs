# Discord Developer Portal → 你的 App → Bot → Reset Token
DISCORD_TOKEN=
# bot 要服務的頻道 ID（開發者模式下在頻道上按右鍵 → 複製頻道 ID），多個用逗號分隔
CHANNEL_IDS=
# 中央氣象署開放資料平台的授權碼：https://opendata.cwa.gov.tw/
CWA_API_KEY=

# 以下通常不用改
DB_PATH=data/bot.db
TZ_NAME=Asia/Taipei
WEB_HOST=127.0.0.1
WEB_PORT=8080
# 用 Cloudflare Access 保護設定頁時填你的 email（只有 Access 驗證過、且是這個 email 才放行）
ADMIN_EMAIL=
# 想多一層帳密就填（帳號 admin）；用 SSH 轉發連設定頁時建議填
WEB_PASSWORD=
